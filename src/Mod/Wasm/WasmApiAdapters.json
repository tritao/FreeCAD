{
  "schema": "org.freecad.wasm.adapters",
  "schema_version": 1,
  "adapters": [
    {
      "name": "documentNew",
      "wire_name": "document.new",
      "id": 1,
      "guest_method": "documentNew",
      "permission": "document.create",
      "mutates": true,
      "requires": ["src/App/Document.pyi"],
      "params": [
        {"name": "name", "type": {"kind": "string", "annotation": "str"}}
      ],
      "returns": {"kind": "handle", "type": "FreeCAD.Document", "annotation": "Document", "ownership": "owned", "nullable": false}
    },
    {
      "name": "partMakeBox",
      "wire_name": "part.make_box",
      "id": 2,
      "guest_method": "partMakeBox",
      "permission": "geometry.create",
      "mutates": true,
      "requires": ["src/Mod/Part/App/TopoShape.pyi"],
      "params": [
        {"name": "length", "type": {"kind": "float64", "annotation": "float"}},
        {"name": "width", "type": {"kind": "float64", "annotation": "float"}},
        {"name": "height", "type": {"kind": "float64", "annotation": "float"}}
      ],
      "returns": {"kind": "handle", "type": "Part.TopoShape", "annotation": "TopoShape", "ownership": "owned", "nullable": false}
    },
    {
      "name": "documentAddObject",
      "wire_name": "document.add_object",
      "id": 3,
      "guest_method": "documentAddObject",
      "source": "FreeCAD.Document.addObject",
      "permission": "document.modify",
      "mutates": true,
      "transaction": "required",
      "requires": ["src/App/Document.pyi", "src/Mod/Part/App/TopoShape.pyi"],
      "params": [
        {"name": "document", "type": {"kind": "handle", "type": "FreeCAD.Document", "annotation": "Document"}},
        {"name": "shape", "type": {"kind": "handle", "type": "Part.TopoShape", "annotation": "TopoShape"}},
        {"name": "name", "type": {"kind": "string", "annotation": "str"}}
      ],
      "returns": {"kind": "handle", "type": "FreeCAD.DocumentObject", "annotation": "DocumentObject", "ownership": "owned", "nullable": false}
    },
    {
      "name": "release",
      "wire_name": "handle.release",
      "id": 4,
      "guest_method": "release",
      "permission": null,
      "mutates": false,
      "params": [
        {"name": "handle", "ownership": "borrowed", "type": {"kind": "handle", "type": "Wasm.Handle", "annotation": "Handle"}}
      ],
      "returns": {"kind": "bool", "annotation": "bool", "nullable": false},
      "consumes": true
    },
    {
      "name": "vectorNew",
      "wire_name": "base.vector.new",
      "id": 5,
      "guest_method": "vectorNew",
      "source": "FreeCAD.Base.Vector.__init__",
      "permission": "geometry.compute",
      "mutates": false,
      "requires": ["src/Base/Vector.pyi"],
      "params": [
        {"name": "x", "type": {"kind": "float64", "annotation": "float"}},
        {"name": "y", "type": {"kind": "float64", "annotation": "float"}},
        {"name": "z", "type": {"kind": "float64", "annotation": "float"}}
      ],
      "returns": {"kind": "value", "type": "FreeCAD.Base.Vector", "encoding": "vector3-f64", "annotation": "Vector"}
    },
    {
      "name": "documentOpenTransaction",
      "wire_name": "document.open_transaction",
      "id": 16,
      "guest_method": "documentOpenTransaction",
      "source": "FreeCAD.Document.openTransaction",
      "permission": "document.modify",
      "mutates": true,
      "transaction": "open",
      "requires": ["src/App/Document.pyi"],
      "params": [
        {"name": "document", "type": {"kind": "handle", "type": "FreeCAD.Document", "annotation": "Document"}},
        {"name": "name", "type": {"kind": "string", "annotation": "str"}}
      ],
      "returns": {"kind": "bool", "annotation": "bool"}
    },
    {
      "name": "documentCommitTransaction",
      "wire_name": "document.commit_transaction",
      "id": 17,
      "guest_method": "documentCommitTransaction",
      "source": "FreeCAD.Document.commitTransaction",
      "permission": "document.modify",
      "mutates": true,
      "transaction": "commit",
      "requires": ["src/App/Document.pyi"],
      "params": [
        {"name": "document", "type": {"kind": "handle", "type": "FreeCAD.Document", "annotation": "Document"}}
      ],
      "returns": {"kind": "bool", "annotation": "bool"}
    },
    {
      "name": "documentAbortTransaction",
      "wire_name": "document.abort_transaction",
      "id": 18,
      "guest_method": "documentAbortTransaction",
      "source": "FreeCAD.Document.abortTransaction",
      "permission": "document.modify",
      "mutates": true,
      "transaction": "abort",
      "requires": ["src/App/Document.pyi"],
      "params": [
        {"name": "document", "type": {"kind": "handle", "type": "FreeCAD.Document", "annotation": "Document"}}
      ],
      "returns": {"kind": "bool", "annotation": "bool"}
    }
  ]
}
