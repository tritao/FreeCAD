
toolset := "emscripten"
variant := "release"
emscripten-sysroot := "../emsdk/upstream/emscripten/cache/sysroot/"

build-dir := if toolset == "emscripten" { "build_web" } else { "build" }
build-type := if variant == "release" { "RelWithDebInfo" } else { "Debug" }
configure := if toolset == "emscripten" { "emconfigure" } else { "" }

os := if os() == "windows" { "win32" } else if os() == "macos" { "macx" } else { os() }
platform := if toolset == "emscripten" { "wasm-emscripten" } else {
 "" } 

default: configure build install

configure:
    #!/usr/bin/env sh
    mkdir -p {{build-dir}} && cd {{build-dir}}
    {{configure}} ../configure \
        -opensource -confirm-license \
        -xplatform {{platform}} \
        -prefix {{emscripten-sysroot}} \
        -static \
        -nomake examples \
        -no-feature-testlib \
        -no-feature-sql \
        -no-feature-gui \
        -no-feature-widgets \

build:
    cd {{build-dir}} && make -j8 
    # use num_cpus() when its released

install:
    cd {{build-dir}} && make install

